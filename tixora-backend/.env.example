# Server
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT (for fallback/development authentication)
JWT_SECRET=super-secret-tixora-jwt-token-key-change-in-production-2026

# Redis (Distributed Seat Holds & FIFO Queues)
REDIS_URL=redis://localhost:6379

# RabbitMQ (Async Events & Background Workers)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Seat Hold & Booking Configuration
SEAT_HOLD_SECONDS=180
MAX_SEAT_SELECTION=10

# Payment Provider Configuration (Mock / Webhook)
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=mock_secret_key_tixora
PAYMENT_WEBHOOK_SECRET=mock_webhook_secret_tixora

# Google Maps API (Optional: for real-time geocoding and driving distance matrix)
GOOGLE_MAPS_API_KEY=

